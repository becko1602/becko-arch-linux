Screen { background: #070b14; color: #e2e8f0; }
Header { background: #0b1120; color: #c9d7ee; height: 3; }
Footer { background: #0b1120; color: #7d96bb; }
#workspace { height: 1fr; padding: 1 2; }
#sidebar { width: 29; background: #0b1120; border: round #1e2e4a; padding: 1 2; margin-right: 2; }
#wordmark { color: #9cbdf7; text-style: bold; height: 2; }
.eyebrow { color: #687f9f; text-style: bold; height: auto; margin-bottom: 1; }
#tagline { color: #afc3e5; height: auto; margin: 1 0 2 0; }
.section-label { color: #4f6a94; height: auto; margin: 1 0; text-style: bold; }
#connection { color: #6bd6ad; height: auto; }
#voice-label { color: #b8a1e8; margin-top: 1; height: auto; }
#privacy { color: #7589a8; height: auto; }
#examples { color: #839abe; height: auto; }
#system-label { color: #516b91; height: auto; margin-top: 2; }
#conversation { width: 1fr; }
#greeting { height: 3; color: #aac0e5; padding-left: 1; }
#chat { background: #0d1525; border: round #23344f; padding: 1 2; height: 1fr; scrollbar-color: #334b72; }
#controls { height: 3; margin: 1 0; }
#controls Button { margin-right: 1; min-width: 11; width: auto; background: #14223a; color: #b8c9e5; border: none; }
#controls Button.-primary { background: #2d68c9; color: white; }
#controls Button:disabled { color: #52617a; background: #101a2b; }
#prompt { border: tall #35527f; background: #111e32; color: #e1ecfb; }
#prompt:focus { border: tall #5992eb; }
#status { height: 1; color: #637d9e; padding-left: 1; }
ConfirmScreen, SettingsScreen { align: center middle; background: #020611b3; }
#confirmation { width: 66; height: auto; max-height: 90%; border: round #5b7cae; background: #111b2e; padding: 2 3; }
#confirmation Static { height: auto; margin-bottom: 1; }
.dialog-buttons { height: 3; align: right middle; margin-top: 1; }
.dialog-buttons Button { margin-left: 1; }
#settings-dialog { width: 90; height: auto; max-height: 95%; overflow-y: auto; border: round #5b7cae; background: #111b2e; padding: 1 3; }
#settings-dialog Label { margin-top: 1; height: auto; color: #91a9ce; }
#settings-info { height: auto; color: #6b87af; }
#settings-error { height: auto; color: #f19ca6; }
.setting-row { height: 3; }
.setting-row Input, .setting-row Select { width: 1fr; }
.setting-row Input:first-child, .setting-row Select:first-child { margin-right: 1; }
Input { background: #0b1525; border: tall #2d466c; }
Input:focus { border: tall #5c91df; }
Select { background: #0b1525; }
Button { background: #213351; color: #c4d6f1; }
Button.-primary { background: #356fd3; }
